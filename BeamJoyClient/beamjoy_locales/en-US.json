    "beamjoy.window.config.tabs.core.legacyImport.races.button": "Import Races from BeamJoy Free",
    "beamjoy.window.config.tabs.core.legacyImport.races.tooltip": "Scans BeamJoyData/db/scenarii for old BeamJoy Free races (copy that folder in first) and adds every convertible one as a brand-new race. It never overwrites anything already in your list. A race whose name is already used is skipped instead.",
    "beamjoy.window.config.tabs.core.legacyImport.races.none": "No legacy races found.",
    "beamjoy.window.config.tabs.core.legacyImport.races.noneImportable": "Found legacy races, but every one is either already named the same as an existing race or couldn't be converted. Nothing to import.",
